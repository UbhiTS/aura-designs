# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# NextAuth - Generate a random secret: openssl rand -base64 32
NEXTAUTH_SECRET=your_random_secret_here_at_least_32_chars
NEXTAUTH_URL=http://localhost:3000

# Allowed admin emails (comma-separated for multiple admins)
# Example: ADMIN_EMAILS=you@gmail.com,spouse@gmail.com
ADMIN_EMAILS=your_email@gmail.com

# Database (local development - SQLite)
DATABASE_URL="file:./dev.db"

# Database password for Cloud SQL deployment (set before running deploy script)
# DB_PASSWORD=your_secure_database_password

# Google Cloud Storage (for image uploads in production)
# GCS_BUCKET_NAME=your-bucket-name
